---
/**
 * ProjectCard — design-system/components/ProjectCard
 *
 * A bento tile. Exactly one card per page is `featured`: it spans the row and
 * splits into a description pane and a tags/links pane. More than one and
 * nothing reads as "the" featured project any more.
 *
 * Client work is the departure the README doesn't cover. It says not to feature
 * a project with no working link, and for a consulting engineer the strongest
 * evidence is precisely the work with no repo to open. The rule that replaces
 * it — enforced in index.astro, explained in CLAUDE.md — is that such a card
 * must *say* why there is no link, so the foot of the tile never leaves a
 * reader guessing between "under NDA" and "portfolio unfinished".
 *
 * `title`, `meta` and `description` go through RedactedText: any of them may
 * carry a `[[REDACTED: ...]]` marker naming a client this page can't.
 */
import ProjectLinks from './ProjectLinks.astro';
import RedactedText from './RedactedText.astro';
import TagRow from './TagRow.astro';
import type { ResolvedProject } from '../types/profile';

interface Props extends ResolvedProject {
  headingLevel?: 2 | 3 | 4;
}

const {
  title,
  meta,
  description,
  tags,
  links,
  note,
  featured = false,
  eyebrow,
  headingLevel = 3,
} = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

{
  featured ? (
    <article class="project-card featured">
      <div>
        {eyebrow && <span class="label project-eyebrow">{eyebrow}</span>}
        <Heading class="h2 project-title">
          <RedactedText text={title} />
        </Heading>
        {meta && (
          <p class="label project-meta">
            <RedactedText text={meta} />
          </p>
        )}
        <p class="body project-desc">
          <RedactedText text={description} />
        </p>
      </div>
      <div class="project-aside">
        <TagRow tags={tags} />
        {note && <p class="body-sm project-note">{note}</p>}
        <ProjectLinks links={links} />
      </div>
    </article>
  ) : (
    <article class="project-card">
      <Heading class="h2 project-title">
        <RedactedText text={title} />
      </Heading>
      {meta && (
        <p class="label project-meta">
          <RedactedText text={meta} />
        </p>
      )}
      <p class="body project-desc">
        <RedactedText text={description} />
      </p>
      <TagRow tags={tags} />
      {note && <p class="body-sm project-note">{note}</p>}
      <ProjectLinks links={links} />
    </article>
  )
}
