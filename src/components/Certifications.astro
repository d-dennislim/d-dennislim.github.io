---
/**
 * Certifications — design-system/components/Certifications
 *
 * A shelf of hex badges with the Golden Jacket beneath it.
 *
 * ## Grouping — by tier, and labelled
 *
 * An earlier version ordered the badges by domain and showed no labels, because
 * a labelled row per domain made this the tallest section on the page. Ordering
 * without labels turned out to be the worse trade: the reader can't recover the
 * principle, so a deliberate order reads as an arbitrary one.
 *
 * Tier is the grouping that pays for its labels. There are four of them against
 * six-or-so domains, the names are one word each, and the tier is already the
 * axis a reader ranks AWS credentials on — so the row itself carries meaning
 * that twelve loose hexagons couldn't. Labels sit in a left gutter rather than
 * above each row, which is what keeps the height affordable: see the
 * `.cert-tiers` rule in bundle.css.
 *
 * Tier order is seniority descending. A tier with no certifications in it is
 * dropped rather than rendered empty, so a partial set still looks deliberate.
 *
 * ## Badge artwork — a deliberate departure from the design system
 *
 * design-system/README.md, this component's own README and brand-system §16 all
 * say not to reproduce AWS's badge artwork. All three qualify it as "without
 * checking their current asset terms", and §16 points at Credly because it links
 * to live verification. That check was made, and the answer here is to do both:
 * serve our own optimised copy of the art (so the page stays inside its weight
 * budget) and link every badge to its Credly verification page, which is the
 * context those share assets exist for.
 *
 * A certification without `art` still renders the drawn hexagon, so the two can
 * coexist while the remaining badges are collected.
 *
 * The jacket takes art the same way but never a `verifyUrl`: it isn't an exam,
 * so there is no Credly page to verify it against. That makes it the one badge
 * whose art shows the code *instead of* covering it — see below.
 *
 * ## The hover reveal
 *
 * The artwork is layered *over* the hexagon rather than replacing it, so fading
 * the art out on hover or focus reveals the code underneath with no duplicate
 * markup. Focus gets the same treatment as hover — a state offered only to mouse
 * users isn't offered to everyone.
 *
 * The reveal is keyed on `.cert-link`, so an unlinked badge has no state that
 * could ever fade the art. The jacket is the only such badge, and it therefore
 * renders its art *or* its code rather than one over the other — layering them
 * would bury the code under artwork nothing can lift. Either way the badge
 * keeps `role="img"` and its `aria-label`, so what a screen reader announces is
 * identical in both cases.
 *
 * `code` splits on `|` to set a badge over two lines, which is how the design
 * system sets an exam code.
 */
import type { CertTier, ShelfCertification, JacketCertification } from '../types/profile';

interface Props {
  eyebrow: string;
  /** `NN / NN`, supplied by the page. Omitted, the head is just eyebrow + title. */
  index?: string;
  title: string;
  items: ShelfCertification[];
  jacket?: JacketCertification;
  headingLevel?: 2 | 3;
}

const { eyebrow, index: sectionIndex, title, items, jacket, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

/* The tier rows head the shelf, so they sit one level under the section's own
   heading — h3 normally, h4 where the section is embedded at h3. CLAUDE.md
   hard rule 3: heading levels descend without skipping. */
const TierHeading = `h${headingLevel + 1}` as 'h3' | 'h4';

/**
 * Seniority descending, which is also the order AWS lists them in. The visible
 * label is here rather than in profile.json: it's a fixed rendering of the tier
 * token, not copy that varies per certification.
 */
const TIERS: { tier: CertTier; label: string }[] = [
  { tier: 'professional', label: 'Professional' },
  { tier: 'specialty', label: 'Specialty' },
  { tier: 'associate', label: 'Associate' },
  { tier: 'foundational', label: 'Foundational' },
];

const groups = TIERS.map((t) => ({
  ...t,
  certs: items.filter((cert) => cert.tier === t.tier),
})).filter((group) => group.certs.length > 0);

/** Split a badge code onto two lines on `|`, the way the previews do with <br>. */
const lines = (code: string): string[] => code.split('|').map((part) => part.trim());

/* The rendered badge box: --badge-h in bundle.css, and its regular-hexagon
   width. These only hint the aspect for CLS — CSS does the actual sizing. */
const ART_H = 128;
const ART_W = Math.round(ART_H * 0.866);

/* The jacket's own box: --hex-size on .cert-badge-jacket, which this page
   raises to one space-6 step above the shelf badge. Same CLS-hint role as
   above — CSS still does the actual sizing. */
const JACKET_H = 152;
const JACKET_W = Math.round(JACKET_H * 0.866);
---

{/* `.section-head` rather than a bare eyebrow + title: it supplies the row the
    section index sits in, and its own space-8 bottom margin is exactly what
    `.section-title-spaced` used to add under the title, so the gap to the
    shelf is unchanged. */}
<div class="section-head">
  <div>
    <p class="label section-eyebrow">{eyebrow}</p>
    <Heading class="h1 section-title">{title}</Heading>
  </div>
  {sectionIndex && <span class="label section-index">{sectionIndex}</span>}
</div>

<div class="cert-tiers">
  {
    groups.map((group) => (
      <>
        <TierHeading class="label cert-tier-label">{group.label}</TierHeading>
        <ul class="cert-shelf">
          {group.certs.map((cert) => {
            const code = (
              <span class="cert-code">
                {lines(cert.code).map((line, index) => (
                  <>
                    {index > 0 && <br />}
                    {line}
                  </>
                ))}
              </span>
            );

            const art = cert.art && (
              <picture class="cert-art">
                <source srcset={`/badges/${cert.art}-256.avif`} type="image/avif" />
                <source srcset={`/badges/${cert.art}-256.webp`} type="image/webp" />
                <img
                  src={`/badges/${cert.art}-256.webp`}
                  width={ART_W}
                  height={ART_H}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            );

            /* Linked: the <a> carries the only accessible name, so the badge drops
               role="img" and the artwork is decorative. Unlinked: the badge keeps
               role="img" and names itself, exactly as it did before art existed. */
            return (
              <li>
                {cert.verifyUrl ? (
                  <a class="cert-link" href={cert.verifyUrl} aria-label={`${cert.name} — verify on Credly`}>
                    <span class="cert-badge">
                      {code}
                      {art}
                    </span>
                  </a>
                ) : (
                  <span class="cert-badge" role="img" aria-label={cert.name}>
                    {code}
                    {art}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </>
    ))
  }
</div>

{
  jacket && (
    <div class="cert-jacket-block">
      <div class="cert-badge cert-badge-jacket" role="img" aria-label={jacket.name}>
        {jacket.art ? (
          <picture class="cert-art">
            <source srcset={`/badges/${jacket.art}-256.avif`} type="image/avif" />
            <source srcset={`/badges/${jacket.art}-256.webp`} type="image/webp" />
            <img
              src={`/badges/${jacket.art}-256.webp`}
              width={JACKET_W}
              height={JACKET_H}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </picture>
        ) : (
          <span class="cert-code">
            {lines(jacket.code).map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))}
          </span>
        )}
      </div>
      <p class="body-sm cert-caption">{jacket.caption}</p>
    </div>
  )
}
