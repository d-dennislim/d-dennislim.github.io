---
/**
 * Hero — design-system/components/Hero
 *
 * The About section: an asymmetric two-up. Left is identity — name in
 * `display` (the only place that size appears), role in `accent` rather than
 * `brand`, bio, status, links. Right is the `$ whoami` console panel, the one
 * place on the page allowed to read as a dashboard widget.
 *
 * The eyebrow sits above the two-up rather than inside its left column, in the
 * same `.section-head` row every other section uses. That is what gives the
 * section index somewhere to sit at the section's own right edge — inside
 * `.hero-main` it would have aligned to the left column's edge, two-fifths
 * short of where the other four sections put it. See the section-index entry
 * in CLAUDE.md.
 */
import Button from './Button.astro';
import MetricRow from './MetricRow.astro';
import type { Link, Metric, Status } from '../types/profile';

interface Props {
  eyebrow: string;
  /** `NN / NN`, supplied by the page. Omitted, the head is just the eyebrow. */
  index?: string;
  name: string;
  initials: string;
  role: string;
  bio: string;
  status: Status;
  links: Link[];
  metrics: Metric[];
}

const { eyebrow, index, name, initials, role, bio, status, links, metrics } = Astro.props;
---

<div class="section-head">
  <p class="label section-eyebrow">{eyebrow}</p>
  {index && <span class="label section-index">{index}</span>}
</div>

<div class="hero">
  <div class="hero-main">
    <h1 class="display hero-name">{name}</h1>
    <p class="body hero-role">{role}</p>
    <p class="body hero-bio">{bio}</p>
    <p class={`status status-${status.tone} hero-status`}>
      <span class="status-dot"></span><span class="body-sm">{status.label}</span>
    </p>
    <div class="hero-links">
      {
        links.map((link, index) => (
          <Button
            label={link.label}
            href={link.href}
            unavailable={link.unavailable}
            variant={index === 0 ? 'primary' : 'secondary'}
          />
        ))
      }
    </div>
  </div>

  <div class="console-panel">
    <div class="console-head">
      <span class="label console-prompt">$ whoami</span>
      <div class="console-avatar" aria-hidden="true">{initials}</div>
    </div>
    <MetricRow metrics={metrics} />
  </div>
</div>
