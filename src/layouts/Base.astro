---
/**
 * The document shell.
 *
 * The three global stylesheets are imported here and only here. They must not
 * go in a component <style> block: Astro scopes those by default, which would
 * silently break every shared class — .btn-primary, .exp-list, .cert-badge and
 * the dg-* diagram classes all come from bundle.css and are used across
 * components.
 *
 * <body> carries `.ds-canvas`, which is what the design system styles as the
 * page ground (the preview frame supplied that wrapper; here the document is
 * the wrapper). The @media print block in bundle.css targets it too.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/bundle.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

/* Preloaded: the faces used above the fold. Mono 400 (the `code` type style)
   is declared in fonts.css but nothing on this page uses it, so it is not
   preloaded — a preload the browser never needs is a wasted round trip. */
const preloadedFonts = [
  '/fonts/ibm-plex-sans-latin-400-normal.woff2',
  '/fonts/ibm-plex-sans-latin-600-normal.woff2',
  '/fonts/ibm-plex-mono-latin-500-normal.woff2',
  '/fonts/ibm-plex-mono-latin-600-normal.woff2',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    {
      preloadedFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }

    {/*
      Restore the saved mode before first paint.

      This MUST be `is:inline`. A normal Astro <script> is bundled and deferred,
      so the page would paint in the OS mode and then jump to the saved one.
      With no saved choice we set nothing at all, which leaves the
      prefers-color-scheme rule in tokens.css in charge — that is the documented
      default, not a fallback.
    */}
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {
        /* Private mode, or storage disabled. The OS preference still applies. */
      }
    </script>
  </head>

  <body class="ds-canvas" id="top">
    <slot />

    <script>
      /**
       * The theme toggle. One of the two scripts the site ships; the other
       * is the navbar prompt typing, which lives with NavBar.astro.
       *
       * It does not decide which glyph to draw — bundle.css does that off the
       * resolved theme, so the icon is right at first paint. All this does is
       * apply the choice, persist it, and keep the button's announced state in
       * step with what it will do next.
       */
      const KEY = 'theme';
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      const media = window.matchMedia('(prefers-color-scheme: dark)');

      const read = (): string | null => {
        try {
          return localStorage.getItem(KEY);
        } catch {
          /* Private mode, or storage disabled. */
          return null;
        }
      };

      /** No stored choice means we are still following the OS. */
      const currentMode = (): 'light' | 'dark' => {
        const stored = read();
        if (stored === 'light' || stored === 'dark') return stored;
        return media.matches ? 'dark' : 'light';
      };

      if (toggle) {
        const render = (): void => {
          const dark = currentMode() === 'dark';
          toggle.setAttribute('aria-pressed', String(dark));
          toggle.setAttribute('aria-label', dark ? 'Light mode' : 'Dark mode');
        };

        toggle.addEventListener('click', () => {
          const next = currentMode() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem(KEY, next);
          } catch {
            /* Nothing to persist to; the choice still applies to this page. */
          }
          render();
        });

        media.addEventListener('change', () => {
          if (read() === null) render();
        });

        render();
      }
    </script>
  </body>
</html>
