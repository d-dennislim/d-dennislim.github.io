---
/**
 * The document shell.
 *
 * The three global stylesheets are imported here and only here. They must not
 * go in a component <style> block: Astro scopes those by default, which would
 * silently break every shared class — .btn-primary, .exp-list, .cert-badge and
 * the dg-* diagram classes all come from bundle.css and are used across
 * components.
 *
 * <body> carries `.ds-canvas`, which is what the design system styles as the
 * page ground (the preview frame supplied that wrapper; here the document is
 * the wrapper). The @media print block in bundle.css targets it too.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/bundle.css';

import { profile, absoluteUrl } from '../content/profile';
import { personJsonLd } from '../content/seo';

interface Props {
  title: string;
  /**
   * The meta description for this page (§22: 150-160 characters, one per
   * page, never duplicated). Rendered verbatim, placeholder included — see
   * `site.description` in types/profile.ts for why the marker is allowed to
   * reach the build.
   */
  description: string;
  /** This page's site-root path, for the self-referencing canonical. */
  path: string;
  /** §22's `og:type`. `profile` for the portfolio, `article` for a study. */
  ogType?: string;
}

const { title, description, path, ogType = 'profile' } = Astro.props;

/*
 * §22's absolute-URL group: canonical, `og:url`, `og:image`.
 *
 * All three are `null` until `site.origin` is filled, and a `null` here means
 * the tag is not written at all. A relative canonical is not a canonical, a
 * guessed host is the fake URL astro.config.mjs refuses, and `og:image` has to
 * be absolute or no scraper will resolve it — LinkedIn least of all, and §22
 * warns that its first fetch is the one that sticks.
 *
 * The rest of the head does not wait on the domain: description, `og:title`,
 * `og:description`, `twitter:card`, the icons and the manifest are all correct
 * today and all checkable by the pre-publish gate today.
 */
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl('/og.png');
const jsonLd = personJsonLd();

/* Preloaded: the faces used above the fold. Mono 400 (the `code` type style)
   is declared in fonts.css but nothing on this page uses it, so it is not
   preloaded — a preload the browser never needs is a wasted round trip. */
const preloadedFonts = [
  '/fonts/ibm-plex-sans-latin-400-normal.woff2',
  '/fonts/ibm-plex-sans-latin-600-normal.woff2',
  '/fonts/ibm-plex-mono-latin-500-normal.woff2',
  '/fonts/ibm-plex-mono-latin-600-normal.woff2',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    {/*
      §10's icon set. The monogram behind all of these is drawn by
      scripts/build-brand-assets.mjs from tokens.json, so it cannot drift from
      the brand colour the way a hand-exported PNG would. `favicon.svg` is
      listed first and modern browsers prefer it; the 96px PNG is the fallback
      and `apple-touch-icon` is fetched by name whether or not it is declared.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/*
      §22 social metadata. `og:image` carries its dimensions because LinkedIn
      and Slack size the card from the tags before they have fetched the file,
      and `og:image:alt` because a card is an image like any other (§15).
    */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={profile.identity.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta
            property="og:image:alt"
            content={`${profile.identity.name} — ${profile.identity.role}`}
          />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    {
      jsonLd && (
        <script type="application/ld+json" set:html={jsonLd} is:inline />
      )
    }

    {
      preloadedFonts.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }

    {/*
      Restore the saved mode before first paint.

      This MUST be `is:inline`. A normal Astro script block is bundled and deferred,
      so the page would paint in the OS mode and then jump to the saved one.
      With no saved choice we set nothing at all, which leaves the
      prefers-color-scheme rule in tokens.css in charge — that is the documented
      default, not a fallback.
    */}
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {
        /* Private mode, or storage disabled. The OS preference still applies. */
      }
    </script>
  </head>

  <body class="ds-canvas" id="top">
    <slot />

    <script>
      /**
       * The theme toggle. One of the two scripts the site ships; the other
       * is the navbar prompt typing, which lives with NavBar.astro.
       *
       * It does not decide which glyph to draw — bundle.css does that off the
       * resolved theme, so the icon is right at first paint. All this does is
       * apply the choice, persist it, and keep the button's announced state in
       * step with what it will do next.
       */
      const KEY = 'theme';
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      const media = window.matchMedia('(prefers-color-scheme: dark)');

      const read = (): string | null => {
        try {
          return localStorage.getItem(KEY);
        } catch {
          /* Private mode, or storage disabled. */
          return null;
        }
      };

      /** No stored choice means we are still following the OS. */
      const currentMode = (): 'light' | 'dark' => {
        const stored = read();
        if (stored === 'light' || stored === 'dark') return stored;
        return media.matches ? 'dark' : 'light';
      };

      if (toggle) {
        const render = (): void => {
          const dark = currentMode() === 'dark';
          toggle.setAttribute('aria-pressed', String(dark));
          toggle.setAttribute('aria-label', dark ? 'Light mode' : 'Dark mode');
        };

        toggle.addEventListener('click', () => {
          const next = currentMode() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem(KEY, next);
          } catch {
            /* Nothing to persist to; the choice still applies to this page. */
          }
          render();
        });

        media.addEventListener('change', () => {
          if (read() === null) render();
        });

        render();
      }
    </script>
  </body>
</html>
