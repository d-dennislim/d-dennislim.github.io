---
/**
 * The one-page portfolio, assembled from
 * design-system/components/PortfolioPage/preview.html.
 *
 * Section order is fixed by doc/brand-system.md §21: About → Experience →
 * Certifications → Projects → Contact. Experience sits before Certifications
 * deliberately — the certifications are remarkable, but experience is what is
 * being bought.
 *
 * Every string rendered here comes from src/content/profile.json. Nothing is
 * hard-coded except the structural labels the design system itself fixes.
 */
import Base from '../layouts/Base.astro';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Certifications from '../components/Certifications.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Footer from '../components/Footer.astro';
import {
  profile,
  resolveActions,
  resolveProjects,
  channelHref,
  emailAddress,
} from '../content/profile';

/* The five sections, in IA order. The `NN / 05` index shown beside a section
   heading is derived from this list, never authored — and every one of the
   five carries it. The design system's own PortfolioPage preview only marks
   two; see the section-index entry in CLAUDE.md for why this page marks all
   of them. */
const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'certifications', label: 'Certifications' },
  { id: 'projects', label: 'Projects' },
  { id: 'contact', label: 'Contact' },
];

const navLinks = sections.map((section) => ({
  label: section.label,
  href: `#${section.id}`,
}));

const pad = (n: number): string => String(n).padStart(2, '0');
const indexOf = (id: string): string =>
  `${pad(sections.findIndex((section) => section.id === id) + 1)} / ${pad(sections.length)}`;

const projects = resolveProjects();

const featured = projects.filter((project) => project.featured);
if (featured.length > 1) {
  throw new Error(
    `index: ${featured.length} featured projects. Exactly one may be featured — more than one and nothing reads as "the" featured project.`,
  );
}

/* ProjectCard's README says not to feature a project with no working link.
   This page departs from that — for a consulting engineer the strongest
   evidence is the client work with no repo to open, and burying it under a
   personal side project would be a worse page. CLAUDE.md records the
   departure.

   What the departure keeps is the reason behind the rule: a featured tile
   whose call to action goes nowhere reads as an unfinished portfolio. So the
   narrower rule enforced here is that the featured card must offer either a
   route the reader can take or a stated reason there isn't one. Checked at
   build time because a rule in a README is a rule someone eventually
   forgets. */
for (const project of featured) {
  const route = project.links.some((link) => !link.unavailable);
  if (!route && !project.note) {
    throw new Error(
      `index: the featured project ("${project.title}") offers neither a working link nor a note saying why there isn't one. A featured tile that leads nowhere and doesn't say why reads as an unfinished portfolio — give it a link, or mark it "provenance": "client" so it states its reason.`,
    );
  }
}
---

<Base title={profile.site.title} description={profile.site.description} path="/">
  <a class="skip-link body-sm" href="#main">Skip to content</a>

  {/*
    `currentHref` is the answer at first paint and the answer with JavaScript
    off — the top of the page is About. It is not stale: NavBar's section spy
    takes the mark from here and keeps it on whichever section the reader has
    scrolled to. Delete this and the bar loses its no-JS active state.
  */}
  <NavBar
    promptMark={profile.identity.promptMark}
    commands={profile.identity.promptCommands}
    links={navLinks}
    currentHref="#about"
  />

  <main id="main">
    <section class="section" id="about">
      <div class="section-inner">
        <Hero
          eyebrow="About"
          index={indexOf('about')}
          name={profile.identity.name}
          initials={profile.identity.initials}
          role={profile.identity.role}
          bio={profile.identity.bio}
          status={profile.identity.status}
          links={resolveActions(profile.hero.actions)}
          metrics={profile.hero.metrics}
        />
      </div>
    </section>

    <section class="section" id="experience">
      <div class="section-inner">
        <div class="section-head">
          <div>
            <p class="label section-eyebrow">Experience</p>
            <h2 class="h1 section-title">{profile.sections.experienceTitle}</h2>
          </div>
          <span class="label section-index">{indexOf('experience')}</span>
        </div>
        <ul class="exp-list">
          {profile.experience.map((role) => <ExperienceItem {...role} headingLevel={3} />)}
        </ul>
      </div>
    </section>

    <section class="section section-band" id="certifications">
      <div class="section-inner">
        <Certifications
          eyebrow="Certifications"
          index={indexOf('certifications')}
          title={profile.sections.certificationsTitle}
          items={profile.certifications.items}
          jacket={profile.certifications.jacket}
        />
      </div>
    </section>

    <section class="section" id="projects">
      <div class="section-inner">
        <div class="section-head">
          <div>
            <p class="label section-eyebrow">Projects</p>
            <h2 class="h1 section-title">{profile.sections.projectsTitle}</h2>
          </div>
          <span class="label section-index">{indexOf('projects')}</span>
        </div>
        <div class="project-grid">
          {projects.map((project) => <ProjectCard {...project} headingLevel={3} />)}
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="section-inner">
        <ContactBlock
          eyebrow="Contact"
          index={indexOf('contact')}
          heading={profile.contact.heading}
          lead={profile.contact.lead}
          emailLabel={emailAddress}
          emailHref={channelHref('email')}
          actions={resolveActions(profile.contact.actions)}
        />
      </div>
    </section>
  </main>

  <Footer
    copyline={profile.footer.copyline}
    joke={profile.footer.joke}
    links={resolveActions(profile.footer.links)}
  />
</Base>
